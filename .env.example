# Application
APP_ENV=development
APP_NAME=chargeops
APP_VERSION=0.1.0

# MySQL
MYSQL_DSN=mysql+pymysql://chargeops:change-me@127.0.0.1:3306/chargeops

# Chroma
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=chargeops_documents

# OpenAI-compatible Chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible Embedding
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RATE_LIMIT_PER_SECOND=0

# Optional Rerank
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Authentication
AUTH_SECRET=replace-with-a-random-long-secret
AUTH_SECRET_PREVIOUS=
AUTH_TOKEN_ISSUER=chargeops
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_ITERATIONS=310000
RAG_UPLOAD_DIR=data/raw/user_upload/rag
RAG_MAX_FILE_SIZE_MB=5
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change-me

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI foundation
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
READY_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
