# Application
APP_ENV=development
APP_NAME=chargeops
APP_VERSION=0.1.0

# MySQL
MYSQL_DSN=mysql+pymysql://chargeops:change-me@127.0.0.1:3306/chargeops

# Chroma
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=chargeops_documents

# OpenAI-compatible Chat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI-compatible Embedding
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional Rerank
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Authentication
AUTH_SECRET=replace-with-a-random-long-secret
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change-me

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
